      ],
      "text/plain": [
       "{'name': 'llama-31-8b-pipe-sglang-config-v2', 'create_time': datetime.datetime(2026, 2, 22, 20, 49, 38, 860522, tzinfo=tzutc()), 'definition': \"[{'ModelInference': {'models': [{'name': 'llama-31-8b-sglang-config-v1', 'version': '3dfe7ec3-a76f-4ef6-8aa4-f6a8d1806f73', 'sha': 'c737ece29898860ff157c548bfb727778c06a35963f06152bca4b96171691cf7'}]}}]\"}"
      ]
